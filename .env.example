# Server
PORT=8787
APP_ORIGIN=http://localhost:8787
LOG_LEVEL=info

# Leave empty to use the safe in-memory demo repository.
# Example: postgresql://app_user:password@localhost:5432/swing_signal_desk
DATABASE_URL=

# Official Discord bot only. Never use a personal user token.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# AI is optional and disabled by default. Both key and model are required to enable it.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Paper-simulation guardrails
INITIAL_CAPITAL=1000000
MAX_GROSS_UTILIZATION=0.70
MAX_SYMBOL_WEIGHT=0.20
MIN_CASH_RESERVE=0.30
MIN_AUTO_PARSE_CONFIDENCE=0.85
MAX_SIGNAL_AGE_SECONDS=120
